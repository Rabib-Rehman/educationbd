# EducationBd environment variables
#
# HOW TO USE
# 1. Copy this file to a new file named ".env.local" (never commit that file).
# 2. Fill in the real values.
# 3. On Vercel, add the same names under Project Settings > Environment Variables.
#
# Nothing here is needed for Phase 1. These are placeholders for Phase 4 (Supabase).
# The exact Supabase key names will be confirmed in Phase 4.

# The public address of the website (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project address and public key.
# Safe to expose to the browser. Protected by Row Level Security in the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET.
# Server only. Never add "NEXT_PUBLIC_" to this name. Never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=
